# Copy to .env and fill in. Never commit .env. Defaults live in app/config.py.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_MAX_CONCURRENCY=1
GNANI_TIMEOUT_S=30

STT_MODEL=v2.5
STT_LANGUAGE=ta-IN
STT_FORMAT=transcribe
STT_BIAS_SCORE=1.0

TTS_MODEL=timbre-v2.5
TTS_VOICE_TA=Asmita
TTS_VOICE_EN=Kaveri
TTS_SPEED_PROMPT=1.0
TTS_SPEED_READBACK=0.9
TTS_SAMPLE_RATE=24000

EVON_MODE=off

APP_NAME=CyberMitra
SESSION_TTL_S=1800
PACKET_TTL_S=86400
MAX_CLIP_S=25
MAX_TURN_S=300
MAX_TXNS=1
MAX_TURNS_PER_CALL=60
SILENCE_HANDOFF_COUNT=2
QUEUE_MAX_WAIT_S=300

# Shared secret for /operator and /api/operator/*. Empty = the operator API is off.
OPERATOR_TOKEN=

DAILY_SESSION_CAP=40
PER_IP_SESSIONS_PER_HOUR=6
CACHE_DIR=.cache
DEMO_MODE=true

# Experimental telephony (CLAUDE.md section 6.16). Needs a public HTTPS URL, such as ngrok.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PUBLIC_URL=
TWILIO_LANG=ta
